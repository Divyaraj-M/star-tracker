{
  "compilerOptions": {
    "baseUrl": "src",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "importHelpers": false,
    "isolatedModules": true,
    "strictNullChecks": false,
    "strictBindCallApply": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2020"],
    "types": []
  },
  "include": ["src/**/*.ts"]
}
